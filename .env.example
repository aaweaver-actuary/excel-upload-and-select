# Copy to .env and adjust only if the default host ports are occupied.
FRONTEND_PORT=8080
BACKEND_PORT=8000
# Zero disables automatic retention deletion.
PIPELINE_VERSION=foundation-1
MAX_FILE_BYTES=20971520
MAX_ROWS=50000
MAX_REQUEST_BYTES=67108864
MAX_EXPANDED_BYTES=209715200
MAX_WORKBOOK_CELLS=1000000
WORKER_POLL_INTERVAL=1
WORKER_MAX_ATTEMPTS=3
WORKER_STALE_SECONDS=30
NAICS_MAX_CONCURRENCY=8
NAICS_REQUEST_TIMEOUT_SECONDS=10
NAICS_MAX_RETRIES=2
NAICS_RETRY_BASE_SECONDS=0.5
NAICS_CACHE_TTL=86400
ARTIFACT_RETENTION_DAYS=0
